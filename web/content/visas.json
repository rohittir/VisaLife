{
  "visas": {
    "H1B": {
      "label": "H-1B",
      "stages": [
        { "id": "new", "label": "Just got my H-1B", "hint": "Approved recently, or just entered on it", "fields": ["i94Expiry", "i797Expiry", "passportExpiry", "visaStampExpiry", "h1bFirstStart"] },
        { "id": "working", "label": "Working on H-1B", "hint": "No green-card process yet", "fields": ["i94Expiry", "i797Expiry", "passportExpiry", "visaStampExpiry", "h1bFirstStart", "timeOutsideUsDays"] },
        { "id": "gc_perm_i140", "label": "Green card started", "hint": "Employer has started PERM or filed the I-140", "fields": ["i94Expiry", "i797Expiry", "ebCategory", "priorityDate", "i140ApprovedOn", "passportExpiry", "visaStampExpiry", "h1bFirstStart", "timeOutsideUsDays"] },
        { "id": "gc_waiting_pd", "label": "Waiting for my priority date", "hint": "I-140 approved, date not current yet", "fields": ["ebCategory", "priorityDate", "i94Expiry", "i797Expiry", "i140ApprovedOn", "passportExpiry", "visaStampExpiry", "h1bFirstStart", "timeOutsideUsDays"] },
        { "id": "i485_pending", "label": "I-485 filed, waiting", "hint": "Adjustment of status is pending", "fields": ["i485FiledOn", "eadExpiry", "apExpiry", "ebCategory", "priorityDate", "i94Expiry", "i797Expiry", "passportExpiry", "visaStampExpiry"] },
        { "id": "approved", "label": "Green card approved", "hint": "Congratulations", "fields": ["passportExpiry"] }
      ]
    },
    "H4": {
      "label": "H-4",
      "stages": [
        { "id": "no_ead", "label": "On H-4, no work permit", "hint": "Dependent of an H-1B holder", "fields": ["i94Expiry", "primaryI140ApprovedOn", "passportExpiry", "visaStampExpiry", "ebCategory", "priorityDate"] },
        { "id": "ead_eligible", "label": "Eligible for H-4 EAD", "hint": "Spouse's I-140 is approved", "fields": ["i94Expiry", "primaryI140ApprovedOn", "passportExpiry", "visaStampExpiry", "ebCategory", "priorityDate"] },
        { "id": "ead_working", "label": "Working on H-4 EAD", "hint": "EAD in hand", "fields": ["eadExpiry", "i94Expiry", "primaryI140ApprovedOn", "passportExpiry", "visaStampExpiry", "ebCategory", "priorityDate"] },
        { "id": "i485_derivative", "label": "I-485 filed with my spouse", "hint": "Adjustment of status is pending", "fields": ["i485FiledOn", "eadExpiry", "apExpiry", "i94Expiry", "passportExpiry", "visaStampExpiry", "ebCategory", "priorityDate"] }
      ]
    },
    "F1": {
      "label": "F-1 / OPT",
      "stages": [
        { "id": "enrolled", "label": "Enrolled, studying", "hint": "Still in my program", "fields": ["programEnd", "passportExpiry", "visaStampExpiry", "travelSignatureDate"] },
        { "id": "opt_applying", "label": "Applying for OPT", "hint": "Graduating within a few months", "fields": ["programEnd", "passportExpiry", "visaStampExpiry", "travelSignatureDate"] },
        { "id": "opt", "label": "On OPT", "hint": "Post-completion OPT EAD in hand", "fields": ["optStart", "optEnd", "unemploymentDaysUsed", "passportExpiry", "visaStampExpiry", "travelSignatureDate"] },
        { "id": "stem_opt", "label": "On STEM OPT", "hint": "24-month extension", "fields": ["stemOptStart", "stemOptEnd", "unemploymentDaysUsed", "passportExpiry", "visaStampExpiry", "travelSignatureDate"] },
        { "id": "h1b_selected", "label": "Selected in the H-1B lottery", "hint": "Petition filed or being filed", "fields": ["optEnd", "stemOptEnd", "passportExpiry", "visaStampExpiry"] },
        { "id": "ending", "label": "OPT ending, not selected", "hint": "Grace period and options", "fields": ["optEnd", "stemOptEnd", "passportExpiry"] }
      ]
    }
