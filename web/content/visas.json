    "apExpiry": { "label": "Advance parole expiry", "type": "date" },
    "programEnd": { "label": "Program end date (I-20)", "type": "date" },
    "optStart": { "label": "OPT EAD start", "type": "date" },
    "optEnd": { "label": "OPT EAD end", "type": "date" },
    "stemOptStart": { "label": "STEM OPT start", "type": "date" },
    "stemOptEnd": { "label": "STEM OPT end", "type": "date" },
    "unemploymentDaysUsed": { "label": "Unemployment days used so far", "type": "number" },
    "travelSignatureDate": { "label": "Last I-20 travel signature", "type": "date" }
