  "flags": [
    { "id": "spouseOnH4", "label": "My spouse is on H-4", "type": "boolean", "visas": ["H1B"] },
    { "id": "pendingI539", "label": "I have an I-539 extension or change of status pending", "type": "boolean", "visas": ["H4"] },
    { "id": "kidBirthYear", "label": "Oldest child's birth year (if under 21)", "type": "number", "visas": ["H1B", "H4"] }
  ],
  "situations": [
    { "id": "ENTERED_US", "label": "Just entered / returned", "visas": ["H1B", "H4", "F1"] },
    { "id": "TRAVEL_SOON", "label": "Travelling soon", "visas": ["H1B", "H4", "F1"] },
    { "id": "CHANGING_EMPLOYER", "label": "Changing employer", "visas": ["H1B"] },
    { "id": "LAID_OFF", "label": "Laid off", "visas": ["H1B"] },
    { "id": "MOVED", "label": "Moved home", "visas": ["H1B", "H4", "F1"] }
  ]
